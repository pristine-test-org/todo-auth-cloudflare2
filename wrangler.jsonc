// Static-assets settings for `npx wrangler dev` and `npx wrangler deploy`.
// Cloudflare Pages Git builds use the dashboard build settings instead (see README).
{
  "name": "todo-auth-cloudflare2",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
